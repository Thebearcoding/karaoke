# Keep only the source/configuration still used by the current pipeline.
/karaoke/experiments/*
!/karaoke/experiments/cjk-onsets-v003/
/karaoke/experiments/cjk-onsets-v003/*
!/karaoke/experiments/cjk-onsets-v003/run.py
!/karaoke/experiments/cjk-onsets-v003/protocol.json
/karaoke/models/*
!/karaoke/models/pretrained/
/karaoke/models/pretrained/*
!/karaoke/models/pretrained/*.yaml

